<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8+), so launchers fill their icon shape
     instead of shrinking the old square icon inside a white circle. The
     artwork already sits inside the adaptive icon's safe zone. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/cc_icon_background" />
    <foreground android:drawable="@drawable/cc_icon_foreground_inset" />
</adaptive-icon>
