<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is copied by cloud backup or phone-to-phone transfer. The app's
     storage holds the relay access key, which shouldn't leave the phone, and
     a device ID that must be unique to each phone. Favorites and settings
     move with Settings > Backup instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
